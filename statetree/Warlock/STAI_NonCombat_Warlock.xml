<?xml version="1.0" encoding="utf-8"?>
<StateTree version="2">
  <Comment>NonCombat state tree for Warlock bots: AiPlayerbot.StateTree.NonCombat.Warlock
    picks the subtree for the bot's map; an instance change selects again</Comment>
  <GlobalTasks>
    <Task class="InstanceProvider_GlobalTask">
      <Comment>the bot's map / instance: mapId, instanceId, inDungeon, onInstanceChanged</Comment>
    </Task>
  </GlobalTasks>
  <State name="Dungeon">
    <EnterConditions>
      <Condition class="Condition_Compare" binding="Root|InstanceProvider_GlobalTask::inDungeon"/>
    </EnterConditions>
    <Tasks>
      <Task class="Task_RunSubtree">
        <Subtree filename="statetree/Warlock/STAI_NonCombat_Dungeon_Warlock.xml"/>
      </Task>
    </Tasks>
    <Transitions>
      <Transition trigger="OnDelegate" source="Root|InstanceProvider_GlobalTask::onInstanceChanged" target="Root"/>
    </Transitions>
  </State>
  <State name="Outdoors">
    <Tasks>
      <Task class="Task_RunSubtree">
        <Subtree filename="statetree/Warlock/STAI_NonCombat_Outdoors_Warlock.xml"/>
      </Task>
    </Tasks>
    <Transitions>
      <Transition trigger="OnDelegate" source="Root|InstanceProvider_GlobalTask::onInstanceChanged" target="Root"/>
    </Transitions>
  </State>
</StateTree>
