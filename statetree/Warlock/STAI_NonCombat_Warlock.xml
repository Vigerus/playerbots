<?xml version="1.0" encoding="utf-8"?>
<!-- NonCombat state tree for Warlock bots: AiPlayerbot.StateTree.NonCombat.Warlock -->
<!-- picks the subtree for the bot's map; an instance change selects again -->
<Root>
  <Global>
    <!-- the bot's map / instance: mapId, instanceId, inDungeon, onInstanceChanged -->
    <Task class="InstanceProvider_GlobalTask"/>
  </Global>
  <Node name="Dungeon">
    <Conditions>
      <Condition binding="Root|InstanceProvider_GlobalTask::inDungeon"/>
    </Conditions>
    <Task class="Task_RunSubtree">
      <Subtree filename="statetree/Warlock/STAI_NonCombat_Dungeon_Warlock.xml"/>
    </Task>
    <Transitions>
      <Transition type="OnDelegate" source="Root|InstanceProvider_GlobalTask::onInstanceChanged" node="Root"/>
    </Transitions>
  </Node>
  <Node name="Outdoors">
    <Conditions/>
    <Task class="Task_RunSubtree">
      <Subtree filename="statetree/Warlock/STAI_NonCombat_Outdoors_Warlock.xml"/>
    </Task>
    <Transitions>
      <Transition type="OnDelegate" source="Root|InstanceProvider_GlobalTask::onInstanceChanged" node="Root"/>
    </Transitions>
  </Node>
</Root>
