<?xml version="1.0" encoding="utf-8"?>
<!-- Dead state tree for Shaman bots: AiPlayerbot.StateTree.Dead.Shaman (STAI_Dead.xml with Reincarnation) -->
<Root>
  <Global>
    <!-- where the body is: released, corpseLocation, corpseFar, onCorpseFar -->
    <Task class="CorpseProvider_GlobalTask"/>
    <!-- movement goal (MovementGoal_GlobalTask): the ghost runs back to its body (a body in a dungeon through its
         portal, where the core resurrects the ghost; outdoors the Reaction tree reclaims the body once in reach) -->
    <Task class="MovementGoal_GlobalTask" name="Corpse Run" priority="10" kind="location">
      <Radius value="10"/>
      <Binding local="location" external="Root|CorpseProvider_GlobalTask::corpseLocation"/>
    </Task>
  </Global>
  <!-- Reincarnation: the core offers it when the bot dies while it is off cooldown and an Ankh is in the bags (gone
       once released); fails without it (the node waits its retry delay) -->
  <Node name="Reincarnation">
    <Conditions>
      <Condition binding="Root|CorpseProvider_GlobalTask::released" negate="true"/>
    </Conditions>
    <Task class="Task_SelfResurrect">
      <Spell id="21169"/>  <!-- Reincarnation -->
    </Task>
  </Node>
  <!-- the spirit goes to the graveyard (outside the dungeon after a death inside one); a resurrection offered to the
       ghost is still accepted by the Reaction tree (Accept Resurrection) -->
  <Node name="Release Spirit">
    <Conditions>
      <Condition binding="Root|CorpseProvider_GlobalTask::released" negate="true"/>
    </Conditions>
    <Task class="Task_ReleaseSpirit"/>
  </Node>
  <Node name="Idle">
    <Conditions/>
    <!-- at the body (the Reaction tree reclaims it) or waiting: selects again every second -->
    <Task class="Task_Wait">
      <Delay value="1000"/>
    </Task>
  </Node>
</Root>
