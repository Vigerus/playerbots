<?xml version="1.0" encoding="utf-8"?>
<StateTree version="2">
  <Comment>Combat subtree for Elem Shaman bots (run by STAI_Combat_Shaman.xml)</Comment>
  <GlobalTasks>
    <Task class="ManaProvider_GlobalTask">
      <Comment>mana of the bot: manaPct, onManaChanged</Comment>
    </Task>
    <Task class="InterruptProvider_GlobalTask" spellid="Earth Shock">
      <Comment>interruptible casts of the enemies that Earth Shock reaches now (healing first): whoNeeds, onInterruptNeeded</Comment>
    </Task>
    <Task class="TargetProvider_GlobalTask">
      <Comment>the unit to attack: the first living rti mark, else the dps assist choice: target, onTargetChanged;
        target is held back (empty, Idle waits) while the bot's threat is at 90% or more of the tank's</Comment>
      <WithThreat value="true"/>
      <ThreatAmount value="90"/>
    </Task>
    <Task class="TotemProvider_GlobalTask">
      <Comment>the totems selected for the bot (outdoor, or the master's dungeon stage) that are not up: needs,
        onTotemMissing; onTotemsChanged when the selection changed</Comment>
      <Range value="30"/>
    </Task>
    <Task class="MovementGoal_GlobalTask" name="Attack Range" priority="40" kind="range">
      <Comment>movement goal (MovementGoal_GlobalTask): in spell range and sight of the target</Comment>
      <Range max="spell"/>
      <Binding local="target" external="Root|TargetProvider_GlobalTask::target"/>
    </Task>
    <Task class="InstanceProvider_GlobalTask">
      <Comment>the rooms of the dungeon (InstanceSubsystem stages): stagePosition (the bot's point in the master's room, saved
        by rtsc), stagePositionFrom, pathBlocked</Comment>
    </Task>
    <Task class="MovementGoal_GlobalTask" name="Position Yourself" priority="45" kind="position">
      <Comment>movement goal: the bot's point in the master's room (rtsc / the stage file) during the fight too, above Attack Range (the bot casts from there while the target is in range)</Comment>
      <Radius value="2"/>
      <Binding local="position" external="Root|InstanceProvider_GlobalTask::stagePosition"/>
      <Binding local="reason" external="Root|InstanceProvider_GlobalTask::stagePositionFrom"/>
      <Conditions>
        <Condition class="Condition_Compare" binding="Root|InstanceProvider_GlobalTask::pathBlocked" inverted="true"/>
      </Conditions>
    </Task>
  </GlobalTasks>
  <State name="Interrupt">
    <Comment>Earth Shock only interrupts, it is not part of the rotation</Comment>
    <EnterConditions>
      <Condition class="Condition_Compare" binding="Root|InterruptProvider_GlobalTask::whoNeeds"/>
    </EnterConditions>
    <Tasks>
      <Task class="Task_CastSpell" spellid="Earth Shock">
        <Binding local="whoNeeds" external="Root|InterruptProvider_GlobalTask::whoNeeds"/>
        <Binding local="causes" external="Root|InterruptProvider_GlobalTask::causes"/>
      </Task>
    </Tasks>
  </State>
  <State name="Mana Potion">
    <Comment>low mana: the best mana potion of the bags (fails while none can be used, not selected again for 3s)</Comment>
    <EnterConditions>
      <Condition class="Condition_Compare" binding="Root|ManaProvider_GlobalTask::manaPct" compare="lesser" value="15"/>
    </EnterConditions>
    <Tasks>
      <Task class="Task_UseItem">
        <Item id="13444"/>
        <!-- Major Mana Potion -->
        <Item id="13443"/>
        <!-- Superior Mana Potion -->
        <Item id="6149"/>
        <!-- Greater Mana Potion -->
        <Item id="3827"/>
        <!-- Mana Potion -->
        <Item id="3385"/>
        <!-- Lesser Mana Potion -->
        <Item id="2455"/>
        <!-- Minor Mana Potion -->
      </Task>
    </Tasks>
  </State>
  <State name="Totems">
    <Comment>a selected totem is not up: gets in range of the target first (totems stay where they are dropped), then
      drops the missing totems one per GCD; fails while none can be cast (mana), not selected again for 3s</Comment>
    <EnterConditions>
      <Condition class="Condition_Compare" binding="Root|TotemProvider_GlobalTask::needs"/>
    </EnterConditions>
    <Tasks>
      <Task class="Task_CastTotem">
        <Binding local="needs" external="Root|TotemProvider_GlobalTask::needs"/>
      </Task>
    </Tasks>
    <Transitions>
      <Transition trigger="OnDelegate" source="Root|InterruptProvider_GlobalTask::onInterruptNeeded" target="Root|Interrupt"/>
    </Transitions>
  </State>
  <State name="Attack Target">
    <Comment>the rotation: Lightning Bolt, held back by the threat check of the target</Comment>
    <EnterConditions>
      <Condition class="Condition_Compare" binding="Root|TargetProvider_GlobalTask::target"/>
      <Condition class="Condition_Compare" binding="Root|MovementGoal_GlobalTask[Attack Range]::inRange"/>
    </EnterConditions>
    <Tasks>
      <Task class="Task_CastSpell" spellid="Lightning Bolt">
        <Binding local="target" external="Root|TargetProvider_GlobalTask::target"/>
      </Task>
    </Tasks>
    <Transitions>
      <Transition trigger="OnDelegate" source="Root|InterruptProvider_GlobalTask::onInterruptNeeded" target="Root|Interrupt"/>
    </Transitions>
  </State>
  <State name="Idle">
    <Tasks>
      <Task class="Task_Wait">
        <Comment>nothing to attack: waits briefly (a totem that failed is tried again) or until a delegate sends the tree elsewhere</Comment>
        <Delay value="1"/>
      </Task>
    </Tasks>
    <Transitions>
      <Transition trigger="OnDelegate" source="Root|InterruptProvider_GlobalTask::onInterruptNeeded" target="Root|Interrupt"/>
      <Transition trigger="OnDelegate" source="Root|TotemProvider_GlobalTask::onTotemMissing" target="Root|Totems"/>
      <Transition trigger="OnDelegate" source="Root|TotemProvider_GlobalTask::onTotemsChanged" target="Root"/>
      <Transition trigger="OnDelegate" source="Root|TargetProvider_GlobalTask::onTargetChanged" target="Root|Attack Target"/>
      <Transition trigger="OnDelegate" source="Root|ManaProvider_GlobalTask::onManaChanged" target="Root">
        <Conditions>
          <Condition class="Condition_Compare" binding="Root|ManaProvider_GlobalTask::manaPct" compare="lesser" value="15"/>
        </Conditions>
      </Transition>
    </Transitions>
  </State>
</StateTree>
