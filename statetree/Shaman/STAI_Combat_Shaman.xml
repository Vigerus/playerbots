<?xml version="1.0" encoding="utf-8"?>
<!-- Combat state tree for Shaman bots: AiPlayerbot.StateTree.Combat.Shaman -->
<!-- picks the subtree for the bot's spec; a spec change (talents learned or reset) selects again -->
<Root>
  <Global>
    <!-- the bot's spec: specName, onSpecChanged -->
    <Task class="SpecProvider_GlobalTask"/>
  </Global>
  <Node name="Enh Shaman">
    <Conditions>
      <Condition binding="Root|SpecProvider_GlobalTask::specName" compare="equal" value="enh shaman"/>
    </Conditions>
    <Task class="Task_RunSubtree">
      <Subtree filename="statetree/Shaman/STAI_Combat_Enh_Shaman.xml"/>
    </Task>
    <Transitions>
      <Transition type="OnDelegate" source="Root|SpecProvider_GlobalTask::onSpecChanged" node="Root"/>
    </Transitions>
  </Node>
  <Node name="Resto Shaman">
    <Conditions>
      <Condition binding="Root|SpecProvider_GlobalTask::specName" compare="equal" value="resto shaman"/>
    </Conditions>
    <Task class="Task_RunSubtree">
      <Subtree filename="statetree/Shaman/STAI_Combat_Resto_Shaman.xml"/>
    </Task>
    <Transitions>
      <Transition type="OnDelegate" source="Root|SpecProvider_GlobalTask::onSpecChanged" node="Root"/>
    </Transitions>
  </Node>
  <Node name="Idle">
    <Conditions/>
    <!-- no spec subtree: waits for a spec change -->
    <Task class="Task_Wait">
      <Delay value="0"/>
    </Task>
    <Transitions>
      <Transition type="OnDelegate" source="Root|SpecProvider_GlobalTask::onSpecChanged" node="Root"/>
    </Transitions>
  </Node>
</Root>
