<?xml version="1.0" encoding="utf-8"?>
<StateTree version="2">
  <Comment>Combat state tree for Shaman bots: AiPlayerbot.StateTree.Combat.Shaman
    picks the subtree for the bot's spec; a spec change (talents learned or reset) selects again</Comment>
  <GlobalTasks>
    <Task class="HazardProvider_GlobalTask">
      <Comment>hostile area effects on the ground around the bot: inHazard, safePosition, onHazard</Comment>
      <Margin value="2"/>
    </Task>
    <Task class="SpecProvider_GlobalTask">
      <Comment>the bot's spec: specName, onSpecChanged</Comment>
    </Task>
    <Task class="MovementGoal_GlobalTask" name="Escape Hazard" priority="100" kind="position" interruptCast="true">
      <Comment>movement goal (MovementGoal_GlobalTask): out of a hostile area effect, also while casting, whatever the subtree's
        goals want</Comment>
      <Radius value="1"/>
      <Binding local="position" external="Root|HazardProvider_GlobalTask::safePosition"/>
      <Conditions>
        <Condition class="Condition_Compare" binding="Root|HazardProvider_GlobalTask::inHazard"/>
      </Conditions>
    </Task>
  </GlobalTasks>
  <State name="Elem Shaman">
    <EnterConditions>
      <Condition class="Condition_Compare" binding="Root|SpecProvider_GlobalTask::specName" compare="equal" value="elem shaman"/>
    </EnterConditions>
    <Tasks>
      <Task class="Task_RunSubtree">
        <Subtree filename="statetree/Shaman/STAI_Combat_Elem_Shaman.xml"/>
      </Task>
    </Tasks>
    <Transitions>
      <Transition trigger="OnDelegate" source="Root|SpecProvider_GlobalTask::onSpecChanged" target="Root"/>
    </Transitions>
  </State>
  <State name="Enh Shaman">
    <EnterConditions>
      <Condition class="Condition_Compare" binding="Root|SpecProvider_GlobalTask::specName" compare="equal" value="enh shaman"/>
    </EnterConditions>
    <Tasks>
      <Task class="Task_RunSubtree">
        <Subtree filename="statetree/Shaman/STAI_Combat_Enh_Shaman.xml"/>
      </Task>
    </Tasks>
    <Transitions>
      <Transition trigger="OnDelegate" source="Root|SpecProvider_GlobalTask::onSpecChanged" target="Root"/>
    </Transitions>
  </State>
  <State name="Resto Shaman">
    <EnterConditions>
      <Condition class="Condition_Compare" binding="Root|SpecProvider_GlobalTask::specName" compare="equal" value="resto shaman"/>
    </EnterConditions>
    <Tasks>
      <Task class="Task_RunSubtree">
        <Subtree filename="statetree/Shaman/STAI_Combat_Resto_Shaman.xml"/>
      </Task>
    </Tasks>
    <Transitions>
      <Transition trigger="OnDelegate" source="Root|SpecProvider_GlobalTask::onSpecChanged" target="Root"/>
    </Transitions>
  </State>
  <State name="Idle">
    <Tasks>
      <Task class="Task_Wait">
        <Comment>no spec subtree: waits for a spec change</Comment>
        <Delay value="0"/>
      </Task>
    </Tasks>
    <Transitions>
      <Transition trigger="OnDelegate" source="Root|SpecProvider_GlobalTask::onSpecChanged" target="Root"/>
    </Transitions>
  </State>
</StateTree>
