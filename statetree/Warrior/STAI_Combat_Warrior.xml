<?xml version="1.0" encoding="utf-8"?>
<!-- Combat state tree for Warrior bots: AiPlayerbot.StateTree.Combat.Warrior -->
<!-- picks the subtree for the bot's spec; a spec change (talents learned or reset) selects again -->
<Root>
  <Global>
    <!-- hostile area effects on the ground around the bot: inHazard, safePosition, onHazard -->
    <Task class="HazardProvider_GlobalTask">
      <Margin value="2"/>
    </Task>
    <!-- the bot's spec: specName, onSpecChanged -->
    <Task class="SpecProvider_GlobalTask"/>
    <!-- movement goal (MovementGoal_GlobalTask): out of a hostile area effect, also while casting, whatever the subtree's
         goals want -->
    <Task class="MovementGoal_GlobalTask" name="Escape Hazard" priority="100" kind="position" interruptCast="true">
      <Radius value="1"/>
      <Binding local="position" external="Root|HazardProvider_GlobalTask::safePosition"/>
      <Conditions>
        <Condition binding="Root|HazardProvider_GlobalTask::inHazard"/>
      </Conditions>
    </Task>
  </Global>
  <Node name="Fury Warrior">
    <Conditions>
      <Condition binding="Root|SpecProvider_GlobalTask::specName" compare="equal" value="fury warrior"/>
    </Conditions>
    <Task class="Task_RunSubtree">
      <Subtree filename="statetree/Warrior/STAI_Combat_Fury_Warrior.xml"/>
    </Task>
    <Transitions>
      <Transition type="OnDelegate" source="Root|SpecProvider_GlobalTask::onSpecChanged" node="Root"/>
    </Transitions>
  </Node>
  <Node name="Arms Warrior">
    <Conditions>
      <Condition binding="Root|SpecProvider_GlobalTask::specName" compare="equal" value="arms warrior"/>
    </Conditions>
    <Task class="Task_RunSubtree">
      <Subtree filename="statetree/Warrior/STAI_Combat_Arms_Warrior.xml"/>
    </Task>
    <Transitions>
      <Transition type="OnDelegate" source="Root|SpecProvider_GlobalTask::onSpecChanged" node="Root"/>
    </Transitions>
  </Node>
  <Node name="Prot Warrior">
    <Conditions>
      <Condition binding="Root|SpecProvider_GlobalTask::specName" compare="equal" value="prot warrior"/>
    </Conditions>
    <Task class="Task_RunSubtree">
      <Subtree filename="statetree/Warrior/STAI_Combat_Prot_Warrior.xml"/>
    </Task>
    <Transitions>
      <Transition type="OnDelegate" source="Root|SpecProvider_GlobalTask::onSpecChanged" node="Root"/>
    </Transitions>
  </Node>
  <Node name="Idle">
    <Conditions/>
    <!-- no spec subtree: waits for a spec change -->
    <Task class="Task_Wait">
      <Delay value="0"/>
    </Task>
    <Transitions>
      <Transition type="OnDelegate" source="Root|SpecProvider_GlobalTask::onSpecChanged" node="Root"/>
    </Transitions>
  </Node>
</Root>
