<?xml version="1.0" encoding="utf-8"?>
<StateTree version="2">
  <Comment>Combat subtree for Prot Warrior bots (run by STAI_Combat_Warrior.xml): defensive stance (battle below 10), holds
    the units fighting the group (TankTargetProvider_GlobalTask: loose units first; as off tank not the main tank's),
    faces them where they stand, taunts loose units, Revenge / Shield Block / Shield Slam / Sunder Armor for threat;
    Charge (out of combat) only when it pulls nothing</Comment>
  <GlobalTasks>
    <Task class="HealthProvider_GlobalTask">
      <Comment>health of the bot: healthPct, onHealthChanged</Comment>
    </Task>
    <Task class="WarriorProvider_GlobalTask">
      <Comment>rage, stance, Revenge: rage, stance, revenge, knowsDefensive, onReactive</Comment>
    </Task>
    <Task class="CooldownProvider_GlobalTask">
      <Comment>known and off cooldown: ready[&lt;spell id&gt;] (an unknown spell is never ready)</Comment>
      <Spell id="12975"/>
      <!-- Last Stand -->
      <Spell id="871"/>
      <!-- Shield Wall -->
      <Spell id="355"/>
      <!-- Taunt -->
      <Spell id="23922"/>
      <!-- Shield Slam -->
      <Spell id="6572"/>
      <!-- Revenge -->
      <Spell id="2565"/>
      <!-- Shield Block -->
      <Spell id="2687"/>
      <!-- Bloodrage -->
      <Spell id="100"/>
      <!-- Charge -->
      <Spell id="7386"/>
      <!-- Sunder Armor -->
      <Spell id="1160"/>
      <!-- Demoralizing Shout -->
      <Spell id="845"/>
      <!-- Cleave -->
      <Spell id="78"/>
      <!-- Heroic Strike -->
    </Task>
    <Task class="InterruptProvider_GlobalTask" spellid="Shield Bash">
      <Comment>interruptible casts of the enemies that Shield Bash reaches now (needs a shield): whoNeeds, onInterruptNeeded</Comment>
    </Task>
    <Task class="BuffProvider_GlobalTask">
      <Comment>Battle Shout on the bot (its party gets it with it): needs, onMissingBuff</Comment>
      <Buff spellid="6673" scope="self"/>
      <!-- Battle Shout -->
    </Task>
    <Task class="TankTargetProvider_GlobalTask">
      <Comment>the unit to hold: target, taunt, loose, mainTank, auraStacks[7386] (Sunder Armor on target); onTargetChanged,
        onLoose</Comment>
      <Aura spellid="7386"/>
      <!-- Sunder Armor -->
    </Task>
    <Task class="MeleeProvider_GlobalTask">
      <Comment>the bot against that unit: inMelee, attacking, targetAttacksBot, enemiesInMelee, inCombat, canCharge,
        swingQueued; onMeleeChanged, onCanCharge</Comment>
      <Binding local="target" external="Root|TankTargetProvider_GlobalTask::target"/>
      <ChargeRange min="8" max="25"/>
      <PullRadius value="15"/>
      <FightTime value="2000"/>
    </Task>
    <Task class="MovementGoal_GlobalTask" name="Melee" priority="50" kind="range">
      <Comment>movement goal (MovementGoal_GlobalTask): in melee reach of the target, where it stands (the tank does not go behind)</Comment>
      <Range max="melee"/>
      <Side value="front"/>
      <Binding local="target" external="Root|TankTargetProvider_GlobalTask::target"/>
    </Task>
  </GlobalTasks>
  <State name="Last Stand">
    <EnterConditions>
      <Condition class="Condition_Compare" binding="Root|HealthProvider_GlobalTask::healthPct" compare="lesser" value="25"/>
      <Condition class="Condition_Compare" binding="Root|CooldownProvider_GlobalTask::ready" key="12975"/>
    </EnterConditions>
    <Tasks>
      <Task class="Task_CastSpell" spellid="Last Stand">
        <Target value="self"/>
      </Task>
    </Tasks>
  </State>
  <State name="Shield Wall">
    <EnterConditions>
      <Condition class="Condition_Compare" binding="Root|HealthProvider_GlobalTask::healthPct" compare="lesser" value="20"/>
      <Condition class="Condition_Compare" binding="Root|WarriorProvider_GlobalTask::stance" compare="equal" value="defensive"/>
      <Condition class="Condition_Compare" binding="Root|CooldownProvider_GlobalTask::ready" key="871"/>
    </EnterConditions>
    <Tasks>
      <Task class="Task_CastSpell" spellid="Shield Wall">
        <Target value="self"/>
      </Task>
    </Tasks>
  </State>
  <State name="Health Potion">
    <Comment>low health: the best healing potion of the bags (fails while none can be used, not selected again for 3s)</Comment>
    <EnterConditions>
      <Condition class="Condition_Compare" binding="Root|HealthProvider_GlobalTask::healthPct" compare="lesser" value="20"/>
    </EnterConditions>
    <Tasks>
      <Task class="Task_UseItem">
        <Item id="13446"/>
        <!-- Major Healing Potion -->
        <Item id="3928"/>
        <!-- Superior Healing Potion -->
        <Item id="1710"/>
        <!-- Greater Healing Potion -->
        <Item id="929"/>
        <!-- Healing Potion -->
        <Item id="858"/>
        <!-- Lesser Healing Potion -->
        <Item id="118"/>
        <!-- Minor Healing Potion -->
      </Task>
    </Tasks>
  </State>
  <State name="Charge" retryDelay="3000">
    <Comment>Charge (the bot out of combat, battle stance for it) to a unit that has fought the group for 2s, 8 - 25 yards
      away, with nothing idle near it or the bot; back to defensive below</Comment>
    <EnterConditions>
      <Condition class="Condition_Compare" binding="Root|MeleeProvider_GlobalTask::canCharge"/>
      <Condition class="Condition_Compare" binding="Root|MeleeProvider_GlobalTask::inCombat" inverted="true"/>
      <Condition class="Condition_Compare" binding="Root|CooldownProvider_GlobalTask::ready" key="100"/>
    </EnterConditions>
    <State name="Charge Stance">
      <Tasks>
        <Task class="Task_Stance">
          <Stance value="battle"/>
        </Task>
      </Tasks>
      <Transitions>
        <Transition trigger="OnStateSucceeded" target="NextState"/>
      </Transitions>
    </State>
    <State name="Charge CastSpell">
      <Tasks>
        <Task class="Task_CastSpell" spellid="Charge">
          <Binding local="target" external="Root|TankTargetProvider_GlobalTask::target"/>
        </Task>
      </Tasks>
    </State>
  </State>
  <State name="Defensive Stance">
    <EnterConditions>
      <Condition class="Condition_Compare" binding="Root|WarriorProvider_GlobalTask::knowsDefensive"/>
      <Condition class="Condition_Compare" binding="Root|WarriorProvider_GlobalTask::stance" compare="equal" value="defensive" inverted="true"/>
    </EnterConditions>
    <Tasks>
      <Task class="Task_Stance">
        <Stance value="defensive"/>
      </Task>
    </Tasks>
  </State>
  <State name="Battle Stance">
    <Comment>below 10 (no Defensive Stance yet): battle stance</Comment>
    <EnterConditions>
      <Condition class="Condition_Compare" binding="Root|WarriorProvider_GlobalTask::knowsDefensive" inverted="true"/>
      <Condition class="Condition_Compare" binding="Root|WarriorProvider_GlobalTask::stance" compare="equal" value="battle" inverted="true"/>
    </EnterConditions>
    <Tasks>
      <Task class="Task_Stance">
        <Stance value="battle"/>
      </Task>
    </Tasks>
  </State>
  <State name="Taunt">
    <Comment>a unit attacks a member that is no tank (it is the target: Start Attack below moves the attack to it, the
      Melee goal walks the bot there): taunt it once in 20 yards</Comment>
    <EnterConditions>
      <Condition class="Condition_Compare" binding="Root|TankTargetProvider_GlobalTask::taunt"/>
      <Condition class="Condition_Compare" binding="Root|WarriorProvider_GlobalTask::stance" compare="equal" value="defensive"/>
      <Condition class="Condition_Compare" binding="Root|CooldownProvider_GlobalTask::ready" key="355"/>
      <Condition class="Condition_Compare" binding="Root|MeleeProvider_GlobalTask::targetDistance" compare="lesser or equal" value="20"/>
    </EnterConditions>
    <Tasks>
      <Task class="Task_CastSpell" spellid="Taunt">
        <Binding local="target" external="Root|TankTargetProvider_GlobalTask::taunt"/>
      </Task>
    </Tasks>
  </State>
  <State name="Interrupt">
    <EnterConditions>
      <Condition class="Condition_Compare" binding="Root|InterruptProvider_GlobalTask::whoNeeds"/>
      <Condition class="Condition_Compare" binding="Root|WarriorProvider_GlobalTask::rage" compare="greater or equal" value="10"/>
    </EnterConditions>
    <Tasks>
      <Task class="Task_CastSpell" spellid="Shield Bash">
        <Binding local="whoNeeds" external="Root|InterruptProvider_GlobalTask::whoNeeds"/>
        <Binding local="causes" external="Root|InterruptProvider_GlobalTask::causes"/>
      </Task>
    </Tasks>
  </State>
  <State name="Bloodrage">
    <EnterConditions>
      <Condition class="Condition_Compare" binding="Root|TankTargetProvider_GlobalTask::target"/>
      <Condition class="Condition_Compare" binding="Root|CooldownProvider_GlobalTask::ready" key="2687"/>
      <Condition class="Condition_Compare" binding="Root|WarriorProvider_GlobalTask::rage" compare="lesser" value="20"/>
      <Condition class="Condition_Compare" binding="Root|HealthProvider_GlobalTask::healthPct" compare="greater" value="40"/>
    </EnterConditions>
    <Tasks>
      <Task class="Task_CastSpell" spellid="Bloodrage">
        <Target value="self"/>
      </Task>
    </Tasks>
  </State>
  <State name="Start Attack">
    <Comment>the auto attack on the target (also out of reach: the swings start in reach); the Melee movement goal
      walks the bot to it and keeps it in front of it</Comment>
    <EnterConditions>
      <Condition class="Condition_Compare" binding="Root|TankTargetProvider_GlobalTask::target"/>
      <Condition class="Condition_Compare" binding="Root|MeleeProvider_GlobalTask::attacking" inverted="true"/>
    </EnterConditions>
    <Tasks>
      <Task class="Task_StartAttack">
        <Binding local="target" external="Root|TankTargetProvider_GlobalTask::target"/>
      </Task>
    </Tasks>
  </State>
  <State name="Sunder Stacks">
    <Comment>Sunder Armor stacks first: up to 5 on the target (any warrior's); the filler below keeps them up</Comment>
    <EnterConditions>
      <Condition class="Condition_Compare" binding="Root|MeleeProvider_GlobalTask::inMelee"/>
      <Condition class="Condition_Compare" binding="Root|TankTargetProvider_GlobalTask::auraStacks" key="7386" compare="lesser" value="5"/>
      <Condition class="Condition_Compare" binding="Root|CooldownProvider_GlobalTask::ready" key="7386"/>
      <Condition class="Condition_Compare" binding="Root|WarriorProvider_GlobalTask::rage" compare="greater or equal" value="15"/>
    </EnterConditions>
    <Tasks>
      <Task class="Task_CastSpell" spellid="Sunder Armor">
        <Binding local="target" external="Root|TankTargetProvider_GlobalTask::target"/>
      </Task>
    </Tasks>
  </State>
  <State name="Revenge">
    <EnterConditions>
      <Condition class="Condition_Compare" binding="Root|WarriorProvider_GlobalTask::revenge"/>
      <Condition class="Condition_Compare" binding="Root|WarriorProvider_GlobalTask::stance" compare="equal" value="defensive"/>
      <Condition class="Condition_Compare" binding="Root|MeleeProvider_GlobalTask::inMelee"/>
      <Condition class="Condition_Compare" binding="Root|CooldownProvider_GlobalTask::ready" key="6572"/>
      <Condition class="Condition_Compare" binding="Root|WarriorProvider_GlobalTask::rage" compare="greater or equal" value="5"/>
    </EnterConditions>
    <Tasks>
      <Task class="Task_CastSpell" spellid="Revenge">
        <Binding local="target" external="Root|TankTargetProvider_GlobalTask::target"/>
      </Task>
    </Tasks>
  </State>
  <State name="Shield Block">
    <Comment>the unit hits the bot: block (and Revenge from the blocks)</Comment>
    <EnterConditions>
      <Condition class="Condition_Compare" binding="Root|MeleeProvider_GlobalTask::targetAttacksBot"/>
      <Condition class="Condition_Compare" binding="Root|MeleeProvider_GlobalTask::inMelee"/>
      <Condition class="Condition_Compare" binding="Root|WarriorProvider_GlobalTask::stance" compare="equal" value="defensive"/>
      <Condition class="Condition_Compare" binding="Root|CooldownProvider_GlobalTask::ready" key="2565"/>
      <Condition class="Condition_Compare" binding="Root|WarriorProvider_GlobalTask::rage" compare="greater or equal" value="10"/>
    </EnterConditions>
    <Tasks>
      <Task class="Task_CastSpell" spellid="Shield Block">
        <Target value="self"/>
      </Task>
    </Tasks>
  </State>
  <State name="Shield Slam">
    <EnterConditions>
      <Condition class="Condition_Compare" binding="Root|MeleeProvider_GlobalTask::inMelee"/>
      <Condition class="Condition_Compare" binding="Root|CooldownProvider_GlobalTask::ready" key="23922"/>
      <Condition class="Condition_Compare" binding="Root|WarriorProvider_GlobalTask::rage" compare="greater or equal" value="20"/>
    </EnterConditions>
    <Tasks>
      <Task class="Task_CastSpell" spellid="Shield Slam">
        <Binding local="target" external="Root|TankTargetProvider_GlobalTask::target"/>
      </Task>
    </Tasks>
  </State>
  <State name="Demoralizing Shout">
    <Comment>the units around the bot without the bot's shout (fails while they all have it: not selected again for 3s)</Comment>
    <EnterConditions>
      <Condition class="Condition_Compare" binding="Root|MeleeProvider_GlobalTask::inMelee"/>
      <Condition class="Condition_Compare" binding="Root|CooldownProvider_GlobalTask::ready" key="1160"/>
      <Condition class="Condition_Compare" binding="Root|WarriorProvider_GlobalTask::rage" compare="greater or equal" value="10"/>
    </EnterConditions>
    <Tasks>
      <Task class="Task_CastSpell" spellid="Demoralizing Shout">
        <SkipAura own="true"/>
        <Binding local="target" external="Root|TankTargetProvider_GlobalTask::target"/>
      </Task>
    </Tasks>
  </State>
  <State name="Battle Shout">
    <EnterConditions>
      <Condition class="Condition_Compare" binding="Root|BuffProvider_GlobalTask::needs"/>
      <Condition class="Condition_Compare" binding="Root|WarriorProvider_GlobalTask::rage" compare="greater or equal" value="10"/>
    </EnterConditions>
    <Tasks>
      <Task class="Task_CastBuff">
        <Binding local="needs" external="Root|BuffProvider_GlobalTask::needs"/>
      </Task>
    </Tasks>
  </State>
  <State name="Cleave">
    <Comment>rage to spare: on the next swing (once queued, it waits for the swing)</Comment>
    <EnterConditions>
      <Condition class="Condition_Compare" binding="Root|MeleeProvider_GlobalTask::inMelee"/>
      <Condition class="Condition_Compare" binding="Root|MeleeProvider_GlobalTask::enemiesInMelee" compare="greater or equal" value="2"/>
      <Condition class="Condition_Compare" binding="Root|MeleeProvider_GlobalTask::swingQueued" inverted="true"/>
      <Condition class="Condition_Compare" binding="Root|CooldownProvider_GlobalTask::ready" key="845"/>
      <Condition class="Condition_Compare" binding="Root|WarriorProvider_GlobalTask::rage" compare="greater or equal" value="40"/>
    </EnterConditions>
    <Tasks>
      <Task class="Task_CastSpell" spellid="Cleave">
        <Binding local="target" external="Root|TankTargetProvider_GlobalTask::target"/>
      </Task>
    </Tasks>
  </State>
  <State name="Sunder Armor">
    <Comment>the threat filler</Comment>
    <EnterConditions>
      <Condition class="Condition_Compare" binding="Root|MeleeProvider_GlobalTask::inMelee"/>
      <Condition class="Condition_Compare" binding="Root|CooldownProvider_GlobalTask::ready" key="7386"/>
      <Condition class="Condition_Compare" binding="Root|WarriorProvider_GlobalTask::rage" compare="greater or equal" value="15"/>
    </EnterConditions>
    <Tasks>
      <Task class="Task_CastSpell" spellid="Sunder Armor">
        <Binding local="target" external="Root|TankTargetProvider_GlobalTask::target"/>
      </Task>
    </Tasks>
  </State>
  <State name="Heroic Strike">
    <EnterConditions>
      <Condition class="Condition_Compare" binding="Root|MeleeProvider_GlobalTask::inMelee"/>
      <Condition class="Condition_Compare" binding="Root|MeleeProvider_GlobalTask::swingQueued" inverted="true"/>
      <Condition class="Condition_Compare" binding="Root|CooldownProvider_GlobalTask::ready" key="78"/>
      <Condition class="Condition_Compare" binding="Root|WarriorProvider_GlobalTask::rage" compare="greater or equal" value="45"/>
    </EnterConditions>
    <Tasks>
      <Task class="Task_CastSpell" spellid="Heroic Strike">
        <Binding local="target" external="Root|TankTargetProvider_GlobalTask::target"/>
      </Task>
    </Tasks>
  </State>
  <State name="Idle">
    <Tasks>
      <Task class="Task_Wait" show_log="false">
        <Comment>nothing to hold: waits briefly, sooner on the delegates</Comment>
        <Delay value="200"/>
      </Task>
    </Tasks>
    <Transitions>
      <Transition trigger="OnDelegate" source="Root|TankTargetProvider_GlobalTask::onTargetChanged" target="Root"/>
      <Transition trigger="OnDelegate" source="Root|TankTargetProvider_GlobalTask::onLoose" target="Root"/>
      <Transition trigger="OnDelegate" source="Root|MeleeProvider_GlobalTask::onMeleeChanged" target="Root"/>
      <Transition trigger="OnDelegate" source="Root|MeleeProvider_GlobalTask::onCanCharge" target="Root|Charge"/>
      <Transition trigger="OnDelegate" source="Root|WarriorProvider_GlobalTask::onReactive" target="Root|Revenge"/>
      <Transition trigger="OnDelegate" source="Root|InterruptProvider_GlobalTask::onInterruptNeeded" target="Root|Interrupt"/>
    </Transitions>
  </State>
</StateTree>
