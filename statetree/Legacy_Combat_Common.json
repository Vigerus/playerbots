{
  "brain": "Legacy_Combat_Common",
  "state": "Combat",
  "description": "Class independent Combat strategies (context: random bots, groups, battlegrounds, config overrides). Included by the Default and class strategy lists.",
  "strategies": [
    {"add": ["mount", "avoid mobs"]},
    {"add": ["racials", "default"], "if": {"battleground": false}},
    {
      "description": "bot plays on its own (random/free bot or AI on a real player's character)",
      "if": {"autonomous": true},
      "strategies": [
        {"add": "roll"},
        {"add": ["flee", "boost"], "if": {"inGroup": false}},
        {
          "if": {
            "any": [
              {"realPlayerMaster": true, "config": "jumpWithPlayer"},
              {"battleground": true, "config": "jumpInBg"},
              {"battleground": false, "realPlayerMaster": false}
            ]
          },
          "strategies": [
            {
              "description": "melee bots sometimes jump in combat",
              "add": "rpg jump",
              "if": {"hasStrategy": "close", "chance": "jumpMeleeInCombatChance"}
            }
          ]
        },
        {"add": "chase jump", "if": {"config": "jumpChase"}},
        {"description": "AiPlayerbot.RandomBotCombatStrategies", "change": "config:randomBotCombatStrategies"}
      ],
      "else": [
        {"description": "AiPlayerbot.CombatStrategies", "change": "config:combatStrategies"}
      ]
    },
    {
      "description": "battleground switch",
      "if": {"battleground": true},
      "strategies": [
        {"add": "isle", "if": {"bgType": "IC"}},
        {"add": "warsong", "if": {"bgType": "WS"}},
        {"add": "arathi", "if": {"bgType": "AB"}},
        {"add": "alterac", "if": {"bgType": "AV"}},
        {"add": "eye", "if": {"bgType": "EY"}},
        {"add": "arena", "if": {"arena": true}},
        {"add": ["boost", "racials", "default", "aoe", "dps assist"]},
        {"remove": ["custom::say", "flee", "threat", "follow", "conserve mana", "cast time"]}
      ]
    }
  ]
}
