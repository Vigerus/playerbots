<?xml version="1.0" encoding="utf-8"?>
<!-- Dead state tree for every class: AiPlayerbot.StateTree.Dead.Default -->
<Root>
  <Global>
    <!-- where the body is: released, corpseLocation, corpseFar, onCorpseFar -->
    <Task class="CorpseProvider_GlobalTask"/>
  </Global>
  <!-- the spirit goes to the graveyard (outside the dungeon after a death inside one); a resurrection offered to the
       ghost is still accepted by the Reaction tree (Accept Resurrection) -->
  <Node name="Release Spirit">
    <Conditions>
      <Condition binding="Root|CorpseProvider_GlobalTask::released" negate="true"/>
    </Conditions>
    <Task class="Task_ReleaseSpirit"/>
  </Node>
  <!-- the ghost runs back to its body: a body in a dungeon through its portal, where the core resurrects the ghost;
       outdoors the Reaction tree reclaims the body once in reach (Reclaim Corpse) -->
  <Node name="Corpse Run">
    <Conditions>
      <Condition binding="Root|CorpseProvider_GlobalTask::corpseFar"/>
    </Conditions>
    <Task class="Task_MakePath">
      <Binding local="location" external="Root|CorpseProvider_GlobalTask::corpseLocation"/>
    </Task>
    <Task class="Task_MoveTo">
      <AcceptableRadius value="10"/>
      <Binding local="path" external="Root|Corpse Run|Task_MakePath::path"/>
      <Binding local="location" external="Root|CorpseProvider_GlobalTask::corpseLocation"/>
    </Task>
  </Node>
  <Node name="Idle">
    <Conditions/>
    <!-- at the body (the Reaction tree reclaims it) or waiting: selects again every second -->
    <Task class="Task_Wait">
      <Delay value="1000"/>
    </Task>
    <Transitions>
      <Transition type="OnDelegate" source="Root|CorpseProvider_GlobalTask::onCorpseFar" node="Root|Corpse Run"/>
    </Transitions>
  </Node>
</Root>
