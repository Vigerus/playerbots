{
  "brain": "Legacy_NonCombat",
  "state": "NonCombat",
  "description": "Default NonCombat strategies of StateNode_Legacy for every class (same as the built-in AiFactory defaults).",
  "strategies": [
    {
      "description": "Warrior",
      "if": {"class": "Warrior"},
      "strategies": [
        {
          "description": "Protection talents",
          "if": {"spec": 2},
          "strategies": [
            {"add": ["protection", "tank assist"]}
          ],
          "else": [
            {
              "description": "Arms talents or below level 30",
              "if": {"any": [{"maxLevel": 29}, {"spec": 0}]},
              "strategies": [
                {"add": ["arms", "dps assist"]}
              ],
              "else": [
                {"description": "Fury talents", "add": ["fury", "dps assist"]}
              ]
            }
          ]
        }
      ]
    },
    {
      "description": "Paladin",
      "if": {"class": "Paladin"},
      "strategies": [
        {"description": "Holy talents", "add": ["holy", "dps assist"], "if": {"spec": 0}},
        {"description": "Protection talents", "add": ["protection", "tank assist"], "if": {"spec": 1}},
        {"description": "Retribution talents", "add": ["retribution", "dps assist"], "if": {"spec": 2}},
        {"add": ["cure", "blessing", "aura"]}
      ]
    },
    {
      "description": "Hunter",
      "if": {"class": "Hunter"},
      "strategies": [
        {"description": "Beast Mastery talents", "add": ["beast mastery"], "if": {"spec": 0}},
        {"description": "Marksmanship talents", "add": ["marksmanship"], "if": {"spec": 1}},
        {"description": "Survival talents", "add": ["survival"], "if": {"spec": 2}},
        {"add": ["dps assist", "cc", "aoe", "aspect", "pet"]}
      ]
    },
    {
      "description": "Rogue",
      "if": {"class": "Rogue"},
      "strategies": [
        {"description": "Assassination talents", "add": ["assassination"], "if": {"spec": 0}},
        {"description": "Combat talents", "add": ["combat"], "if": {"spec": 1}},
        {"description": "Subtlety talents", "add": ["subtlety"], "if": {"spec": 2}},
        {"add": ["dps assist", "poisons", "stealth"]}
      ]
    },
    {
      "description": "Priest",
      "if": {"class": "Priest"},
      "strategies": [
        {"description": "Discipline talents", "add": ["discipline"], "if": {"spec": 0}},
        {"description": "Holy talents", "add": ["holy"], "if": {"spec": 1}},
        {"description": "Shadow talents", "add": ["shadow"], "if": {"spec": 2}},
        {"add": ["dps assist", "cure"]}
      ]
    },
    {
      "description": "Shaman",
      "if": {"class": "Shaman"},
      "strategies": [
        {"description": "Elemental talents", "add": ["elemental", "aoe", "cc"], "if": {"spec": 0}},
        {"description": "Enhancement talents", "add": ["enhancement", "aoe", "cc"], "if": {"spec": 1}},
        {"description": "Restoration talents", "add": ["restoration"], "if": {"spec": 2}},
        {"add": ["dps assist", "cure", "totems"]}
      ]
    },
    {
      "description": "Mage",
      "if": {"class": "Mage"},
      "strategies": [
        {"description": "Arcane talents", "add": ["arcane"], "if": {"spec": 0}},
        {"description": "Fire talents", "add": ["fire"], "if": {"spec": 1}},
        {"description": "Frost talents", "add": ["frost"], "if": {"spec": 2}},
        {"add": ["dps assist"]}
      ]
    },
    {
      "description": "Warlock",
      "if": {"class": "Warlock"},
      "strategies": [
        {"description": "Affliction talents", "add": ["affliction"], "if": {"spec": 0}},
        {"description": "Demonology talents", "add": ["demonology"], "if": {"spec": 1}},
        {"description": "Destruction talents", "add": ["destruction"], "if": {"spec": 2}},
        {"add": ["dps assist", "pet"]}
      ]
    },
    {
      "description": "Druid",
      "if": {"class": "Druid"},
      "strategies": [
        {"description": "Balance talents", "add": ["balance", "dps assist"], "if": {"spec": 0}},
        {"description": "Feral talents", "add": ["tank feral", "tank assist"], "if": {"spec": 1}},
        {"description": "Restoration talents", "add": ["restoration", "dps assist"], "if": {"spec": 2}},
        {"add": ["cure", "aoe", "cc"]}
      ]
    },
    {"include": "Legacy_NonCombat_Common.json"}
  ]
}
