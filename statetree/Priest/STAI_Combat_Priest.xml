<?xml version="1.0" encoding="utf-8"?>
<!-- Combat state tree for Priest bots: AiPlayerbot.StateTree.Combat.Priest -->
<!-- picks the subtree for the bot's spec (Holy and Disc share the healer subtree); a spec change (talents learned or
     reset) selects again -->
<Root>
  <Global>
    <!-- hostile area effects on the ground around the bot: inHazard, safePosition, onHazard -->
    <Task class="HazardProvider_GlobalTask">
      <Margin value="2"/>
    </Task>
    <!-- the bot's spec: specName, onSpecChanged -->
    <Task class="SpecProvider_GlobalTask"/>
  </Global>
  <!-- standing in a hostile area effect: walks out first, whatever the rest of the tree (or its subtree) does -->
  <Node name="Escape Hazard">
    <Conditions>
      <Condition binding="Root|HazardProvider_GlobalTask::inHazard"/>
      <Condition binding="Root|HazardProvider_GlobalTask::safePosition"/>
    </Conditions>
    <Task class="Task_MoveToPosition">
      <AcceptableRadius value="1"/>
      <Binding local="position" external="Root|HazardProvider_GlobalTask::safePosition"/>
    </Task>
  </Node>
  <Node name="Holy Priest">
    <Conditions>
      <Condition binding="Root|SpecProvider_GlobalTask::specName" compare="equal" value="holy priest"/>
    </Conditions>
    <Task class="Task_RunSubtree">
      <Subtree filename="statetree/Priest/STAI_Combat_Healer_Priest.xml"/>
    </Task>
    <Transitions>
      <Transition type="OnDelegate" source="Root|HazardProvider_GlobalTask::onHazard" node="Root|Escape Hazard"/>
      <Transition type="OnDelegate" source="Root|SpecProvider_GlobalTask::onSpecChanged" node="Root"/>
    </Transitions>
  </Node>
  <Node name="Disc Priest">
    <Conditions>
      <Condition binding="Root|SpecProvider_GlobalTask::specName" compare="equal" value="disc priest"/>
    </Conditions>
    <Task class="Task_RunSubtree">
      <Subtree filename="statetree/Priest/STAI_Combat_Healer_Priest.xml"/>
    </Task>
    <Transitions>
      <Transition type="OnDelegate" source="Root|HazardProvider_GlobalTask::onHazard" node="Root|Escape Hazard"/>
      <Transition type="OnDelegate" source="Root|SpecProvider_GlobalTask::onSpecChanged" node="Root"/>
    </Transitions>
  </Node>
  <Node name="Shadow Priest">
    <Conditions>
      <Condition binding="Root|SpecProvider_GlobalTask::specName" compare="equal" value="shadow priest"/>
    </Conditions>
    <Task class="Task_RunSubtree">
      <Subtree filename="statetree/Priest/STAI_Combat_Shadow_Priest.xml"/>
    </Task>
    <Transitions>
      <Transition type="OnDelegate" source="Root|HazardProvider_GlobalTask::onHazard" node="Root|Escape Hazard"/>
      <Transition type="OnDelegate" source="Root|SpecProvider_GlobalTask::onSpecChanged" node="Root"/>
    </Transitions>
  </Node>
  <Node name="Idle">
    <Conditions/>
    <!-- no spec subtree: waits for a spec change -->
    <Task class="Task_Wait">
      <Delay value="0"/>
    </Task>
    <Transitions>
      <Transition type="OnDelegate" source="Root|HazardProvider_GlobalTask::onHazard" node="Root|Escape Hazard"/>
      <Transition type="OnDelegate" source="Root|SpecProvider_GlobalTask::onSpecChanged" node="Root"/>
    </Transitions>
  </Node>
</Root>
