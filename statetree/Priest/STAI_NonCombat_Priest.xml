<?xml version="1.0" encoding="utf-8"?>
<!-- NonCombat state tree for Priest bots: AiPlayerbot.StateTree.NonCombat.Priest -->
<!-- picks the subtree for the bot's map; an instance change selects again -->
<Root>
  <Global>
    <!-- the bot's map / instance: mapId, instanceId, inDungeon, onInstanceChanged -->
    <Task class="InstanceProvider_GlobalTask"/>
  </Global>
  <!-- Scholomance (map 289): the dungeon subtree with its own dispel exceptions -->
  <Node name="Scholomance">
    <Conditions>
      <Condition binding="Root|InstanceProvider_GlobalTask::mapId" compare="equal" value="289"/>
    </Conditions>
    <Task class="Task_RunSubtree">
      <Subtree filename="statetree/Priest/STAI_NonCombat_Scholomance_Priest.xml"/>
    </Task>
    <Transitions>
      <Transition type="OnDelegate" source="Root|InstanceProvider_GlobalTask::onInstanceChanged" node="Root"/>
    </Transitions>
  </Node>
  <Node name="Dungeon">
    <Conditions>
      <Condition binding="Root|InstanceProvider_GlobalTask::inDungeon"/>
    </Conditions>
    <Task class="Task_RunSubtree">
      <Subtree filename="statetree/Priest/STAI_NonCombat_Dungeon_Priest.xml"/>
    </Task>
    <Transitions>
      <Transition type="OnDelegate" source="Root|InstanceProvider_GlobalTask::onInstanceChanged" node="Root"/>
    </Transitions>
  </Node>
  <Node name="Outdoors">
    <Conditions/>
    <Task class="Task_RunSubtree">
      <Subtree filename="statetree/Priest/STAI_NonCombat_Outdoors_Priest.xml"/>
    </Task>
    <Transitions>
      <Transition type="OnDelegate" source="Root|InstanceProvider_GlobalTask::onInstanceChanged" node="Root"/>
    </Transitions>
  </Node>
</Root>
