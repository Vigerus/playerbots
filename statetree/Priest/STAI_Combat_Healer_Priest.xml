<?xml version="1.0" encoding="utf-8"?>
<StateTree version="2">
  <Comment>Combat subtree for healing (Holy and Disc) Priest bots (run by STAI_Combat_Priest.xml)</Comment>
  <GlobalTasks>
    <Task class="ManaProvider_GlobalTask">
      <Comment>mana of the bot: manaPct, onManaChanged</Comment>
    </Task>
    <Task class="HealProvider_GlobalTask">
      <Comment>the health of the bot and its group: critical / low / medium / almostFull (worst first), healTarget, aggroed,
        selfAttacked, mainTank, tankOutOfRange; onNeedsHeal, onAggro, onTankOutOfRange</Comment>
      <Critical value="20"/>
      <Low value="50"/>
      <Medium value="70"/>
      <AlmostFull value="90"/>
      <TankRange value="30"/>
    </Task>
    <Task class="DispelProvider_GlobalTask">
      <Comment>harmful magic and diseases on the bot and its group: magic, disease, onNeedsHelp</Comment>
      <Dispel type="magic"/>
      <Dispel type="disease"/>
    </Task>
    <Task class="CooldownProvider_GlobalTask">
      <Comment>Fade only while it is ready: ready[586]</Comment>
      <Spell id="586"/>
      <!-- Fade -->
    </Task>
    <Task class="CCProvider_GlobalTask">
      <Comment>the bot's crowd-control mark (rti cc, default moon), shackled undead count as controlled: whoNeeds, onCCNeeded</Comment>
    </Task>
    <Task class="TargetProvider_GlobalTask">
      <Comment>the unit to attack when nobody needs healing, held back at 90% of the tank's threat: target, onTargetChanged</Comment>
      <WithThreat value="true"/>
      <ThreatAmount value="90"/>
    </Task>
    <Task class="MovementGoal_GlobalTask" name="Heal Range" priority="60" kind="range">
      <Comment>movement goals (MovementGoal_GlobalTask, the highest wanted one drives the bot): in heal range of the most
        wounded member, else close to the main tank when it is out of range, else in spell range of the target</Comment>
      <Range max="35"/>
      <Binding local="target" external="Root|HealProvider_GlobalTask::healTarget"/>
    </Task>
    <Task class="MovementGoal_GlobalTask" name="Follow Tank" priority="50" kind="range">
      <Range max="25"/>
      <Binding local="target" external="Root|HealProvider_GlobalTask::mainTank"/>
      <Conditions>
        <Condition class="Condition_Compare" binding="Root|HealProvider_GlobalTask::tankOutOfRange"/>
      </Conditions>
    </Task>
    <Task class="MovementGoal_GlobalTask" name="Attack Range" priority="40" kind="range">
      <Range max="spell"/>
      <Binding local="target" external="Root|TargetProvider_GlobalTask::target"/>
    </Task>
    <Task class="InstanceProvider_GlobalTask">
      <Comment>the rooms of the dungeon (InstanceSubsystem stages): stagePosition (the bot's point in the master's room, saved
        by rtsc), stagePositionFrom, pathBlocked</Comment>
    </Task>
    <Task class="MovementGoal_GlobalTask" name="Position Yourself" priority="55" kind="position">
      <Comment>movement goal: the bot's point in the master's room (rtsc / the stage file) during the fight too, above Follow Tank and Attack Range, below Heal Range (it leaves the point only to reach a member to heal)</Comment>
      <Radius value="2"/>
      <Binding local="position" external="Root|InstanceProvider_GlobalTask::stagePosition"/>
      <Binding local="reason" external="Root|InstanceProvider_GlobalTask::stagePositionFrom"/>
      <Conditions>
        <Condition class="Condition_Compare" binding="Root|InstanceProvider_GlobalTask::pathBlocked" inverted="true"/>
      </Conditions>
    </Task>
  </GlobalTasks>
  <State name="Shield Critical">
    <Comment>below 20%: a shield first (skipped while Weakened Soul is on them: the node fails and waits 3s), then Flash Heal</Comment>
    <EnterConditions>
      <Condition class="Condition_Compare" binding="Root|HealProvider_GlobalTask::critical"/>
      <Condition class="Condition_Compare" binding="Root|MovementGoal_GlobalTask[Heal Range]::inRange"/>
    </EnterConditions>
    <Tasks>
      <Task class="Task_CastSpell" spellid="Power Word: Shield">
        <SkipAura spellid="6788"/>
        <!-- Weakened Soul -->
        <Binding local="whoNeeds" external="Root|HealProvider_GlobalTask::critical"/>
      </Task>
    </Tasks>
  </State>
  <State name="Critical Heal">
    <EnterConditions>
      <Condition class="Condition_Compare" binding="Root|HealProvider_GlobalTask::critical"/>
      <Condition class="Condition_Compare" binding="Root|MovementGoal_GlobalTask[Heal Range]::inRange"/>
    </EnterConditions>
    <Tasks>
      <Task class="Task_CastSpell" spellid="Flash Heal">
        <Comment>the fastest heal the bot knows: Flash Heal from level 20, before that Heal / Lesser Heal</Comment>
        <Fallback spellid="Heal"/>
        <Fallback spellid="Lesser Heal"/>
        <Binding local="whoNeeds" external="Root|HealProvider_GlobalTask::critical"/>
      </Task>
    </Tasks>
  </State>
  <State name="Fade">
    <Comment>the bot took aggro from the tank: Fade (only with a living tank in the group, while it is off cooldown)</Comment>
    <EnterConditions>
      <Condition class="Condition_Compare" binding="Root|HealProvider_GlobalTask::selfAttacked"/>
      <Condition class="Condition_Compare" binding="Root|HealProvider_GlobalTask::mainTank"/>
      <Condition class="Condition_Compare" binding="Root|CooldownProvider_GlobalTask::ready" key="586"/>
    </EnterConditions>
    <Tasks>
      <Task class="Task_CastSpell" spellid="Fade">
        <Target value="self"/>
      </Task>
    </Tasks>
  </State>
  <State name="Shield Aggroed">
    <Comment>members that are no tank and are attacked (the bot first): a shield, unless Weakened Soul is on them</Comment>
    <EnterConditions>
      <Condition class="Condition_Compare" binding="Root|HealProvider_GlobalTask::aggroed"/>
    </EnterConditions>
    <Tasks>
      <Task class="Task_CastSpell" spellid="Power Word: Shield">
        <SkipAura spellid="6788"/>
        <!-- Weakened Soul -->
        <Binding local="whoNeeds" external="Root|HealProvider_GlobalTask::aggroed"/>
      </Task>
    </Tasks>
  </State>
  <State name="Shield Low">
    <Comment>below 50%: a shield, then Greater Heal (Heal / Lesser Heal before the bot knows it)</Comment>
    <EnterConditions>
      <Condition class="Condition_Compare" binding="Root|HealProvider_GlobalTask::low"/>
      <Condition class="Condition_Compare" binding="Root|MovementGoal_GlobalTask[Heal Range]::inRange"/>
    </EnterConditions>
    <Tasks>
      <Task class="Task_CastSpell" spellid="Power Word: Shield">
        <SkipAura spellid="6788"/>
        <!-- Weakened Soul -->
        <Binding local="whoNeeds" external="Root|HealProvider_GlobalTask::low"/>
      </Task>
    </Tasks>
  </State>
  <State name="Low Heal">
    <EnterConditions>
      <Condition class="Condition_Compare" binding="Root|HealProvider_GlobalTask::low"/>
      <Condition class="Condition_Compare" binding="Root|MovementGoal_GlobalTask[Heal Range]::inRange"/>
    </EnterConditions>
    <Tasks>
      <Task class="Task_CastSpell" spellid="Greater Heal">
        <Fallback spellid="Heal"/>
        <Fallback spellid="Lesser Heal"/>
        <Binding local="whoNeeds" external="Root|HealProvider_GlobalTask::low"/>
      </Task>
    </Tasks>
  </State>
  <State name="Dispel Magic">
    <EnterConditions>
      <Condition class="Condition_Compare" binding="Root|DispelProvider_GlobalTask::magic"/>
    </EnterConditions>
    <Tasks>
      <Task class="Task_CastSpell" spellid="Dispel Magic">
        <Binding local="whoNeeds" external="Root|DispelProvider_GlobalTask::magic"/>
        <Binding local="causes" external="Root|DispelProvider_GlobalTask::causes"/>
      </Task>
    </Tasks>
  </State>
  <State name="Cure Disease">
    <EnterConditions>
      <Condition class="Condition_Compare" binding="Root|DispelProvider_GlobalTask::disease"/>
    </EnterConditions>
    <Tasks>
      <Task class="Task_CastSpell" spellid="Abolish Disease">
        <Fallback spellid="Cure Disease"/>
        <!-- Abolish Disease keeps curing: not cast again while it is on the target -->
        <SkipAura own="true"/>
        <Binding local="whoNeeds" external="Root|DispelProvider_GlobalTask::disease"/>
        <Binding local="causes" external="Root|DispelProvider_GlobalTask::causes"/>
      </Task>
    </Tasks>
  </State>
  <State name="Medium Heal">
    <Comment>below 70%: Heal (Lesser Heal at low levels), cheaper than Greater Heal</Comment>
    <EnterConditions>
      <Condition class="Condition_Compare" binding="Root|HealProvider_GlobalTask::medium"/>
      <Condition class="Condition_Compare" binding="Root|MovementGoal_GlobalTask[Heal Range]::inRange"/>
    </EnterConditions>
    <Tasks>
      <Task class="Task_CastSpell" spellid="Heal">
        <Fallback spellid="Lesser Heal"/>
        <Binding local="whoNeeds" external="Root|HealProvider_GlobalTask::medium"/>
      </Task>
    </Tasks>
  </State>
  <State name="Renew">
    <Comment>below 90%: Renew, unless the bot's Renew is on them already (then the node fails and waits 3s)</Comment>
    <EnterConditions>
      <Condition class="Condition_Compare" binding="Root|HealProvider_GlobalTask::almostFull"/>
      <Condition class="Condition_Compare" binding="Root|MovementGoal_GlobalTask[Heal Range]::inRange"/>
    </EnterConditions>
    <Tasks>
      <Task class="Task_CastSpell" spellid="Renew">
        <SkipAura own="true"/>
        <Binding local="whoNeeds" external="Root|HealProvider_GlobalTask::almostFull"/>
      </Task>
    </Tasks>
  </State>
  <State name="Mana Potion">
    <Comment>low mana: the best mana potion of the bags (fails while none can be used, not selected again for 3s)</Comment>
    <EnterConditions>
      <Condition class="Condition_Compare" binding="Root|ManaProvider_GlobalTask::manaPct" compare="lesser" value="15"/>
    </EnterConditions>
    <Tasks>
      <Task class="Task_UseItem">
        <Item id="13444"/>
        <!-- Major Mana Potion -->
        <Item id="13443"/>
        <!-- Superior Mana Potion -->
        <Item id="6149"/>
        <!-- Greater Mana Potion -->
        <Item id="3827"/>
        <!-- Mana Potion -->
        <Item id="3385"/>
        <!-- Lesser Mana Potion -->
        <Item id="2455"/>
        <!-- Minor Mana Potion -->
      </Task>
    </Tasks>
  </State>
  <State name="Shackle">
    <Comment>the moon mark: Shackle Undead (fails on anything that is not undead)</Comment>
    <EnterConditions>
      <Condition class="Condition_Compare" binding="Root|CCProvider_GlobalTask::whoNeeds"/>
    </EnterConditions>
    <Tasks>
      <Task class="Task_CastSpell" spellid="Shackle Undead">
        <Binding local="whoNeeds" external="Root|CCProvider_GlobalTask::whoNeeds"/>
      </Task>
    </Tasks>
  </State>
  <State name="Shadow Word: Pain">
    <Comment>mana to spare: some damage, one cast per visit (the heal nodes above come first after each); the damage over
      time spells are skipped (the node fails, 3s) while the bot's own is on the target</Comment>
    <EnterConditions>
      <Condition class="Condition_Compare" binding="Root|TargetProvider_GlobalTask::target"/>
      <Condition class="Condition_Compare" binding="Root|ManaProvider_GlobalTask::manaPct" compare="greater" value="70"/>
      <Condition class="Condition_Compare" binding="Root|MovementGoal_GlobalTask[Attack Range]::inRange"/>
    </EnterConditions>
    <Tasks>
      <Task class="Task_CastSpell" spellid="Shadow Word: Pain">
        <SkipAura own="true"/>
        <Binding local="target" external="Root|TargetProvider_GlobalTask::target"/>
      </Task>
    </Tasks>
  </State>
  <State name="Holy Fire">
    <EnterConditions>
      <Condition class="Condition_Compare" binding="Root|TargetProvider_GlobalTask::target"/>
      <Condition class="Condition_Compare" binding="Root|ManaProvider_GlobalTask::manaPct" compare="greater" value="70"/>
      <Condition class="Condition_Compare" binding="Root|MovementGoal_GlobalTask[Attack Range]::inRange"/>
    </EnterConditions>
    <Tasks>
      <Task class="Task_CastSpell" spellid="Holy Fire">
        <SkipAura own="true"/>
        <Binding local="target" external="Root|TargetProvider_GlobalTask::target"/>
      </Task>
    </Tasks>
  </State>
  <State name="Smite">
    <EnterConditions>
      <Condition class="Condition_Compare" binding="Root|TargetProvider_GlobalTask::target"/>
      <Condition class="Condition_Compare" binding="Root|ManaProvider_GlobalTask::manaPct" compare="greater" value="70"/>
      <Condition class="Condition_Compare" binding="Root|MovementGoal_GlobalTask[Attack Range]::inRange"/>
    </EnterConditions>
    <Tasks>
      <Task class="Task_CastSpell" spellid="Smite">
        <Binding local="target" external="Root|TargetProvider_GlobalTask::target"/>
      </Task>
    </Tasks>
  </State>
  <State name="Wand">
    <Comment>less mana: the wand (no mana spent, the mana regenerates) until a heal is needed or the mana is back above 70%</Comment>
    <EnterConditions>
      <Condition class="Condition_Compare" binding="Root|TargetProvider_GlobalTask::target"/>
      <Condition class="Condition_Compare" binding="Root|MovementGoal_GlobalTask[Attack Range]::inRange"/>
    </EnterConditions>
    <Tasks>
      <Task class="Task_Shoot">
        <Binding local="target" external="Root|TargetProvider_GlobalTask::target"/>
      </Task>
    </Tasks>
    <Transitions>
      <Transition trigger="OnDelegate" source="Root|HealProvider_GlobalTask::onNeedsHeal" target="Root"/>
      <Transition trigger="OnDelegate" source="Root|HealProvider_GlobalTask::onAggro" target="Root"/>
      <Transition trigger="OnDelegate" source="Root|HealProvider_GlobalTask::onTankOutOfRange" target="Root"/>
      <Transition trigger="OnDelegate" source="Root|DispelProvider_GlobalTask::onNeedsHelp" target="Root"/>
      <Transition trigger="OnDelegate" source="Root|CCProvider_GlobalTask::onCCNeeded" target="Root"/>
      <Transition trigger="OnDelegate" source="Root|TargetProvider_GlobalTask::onTargetChanged" target="Root"/>
      <Transition trigger="OnDelegate" source="Root|ManaProvider_GlobalTask::onManaChanged" target="Root">
        <Conditions>
          <Condition class="Condition_Compare" binding="Root|ManaProvider_GlobalTask::manaPct" compare="greater" value="70"/>
        </Conditions>
      </Transition>
    </Transitions>
  </State>
  <State name="Idle">
    <Tasks>
      <Task class="Task_Wait">
        <Comment>nothing to heal, dispel or attack: selects again every second (a Renew ran out, a heal node's retry delay is
          over), sooner when a delegate fires</Comment>
        <Delay value="1000"/>
      </Task>
    </Tasks>
    <Transitions>
      <Transition trigger="OnDelegate" source="Root|HealProvider_GlobalTask::onNeedsHeal" target="Root"/>
      <Transition trigger="OnDelegate" source="Root|HealProvider_GlobalTask::onAggro" target="Root"/>
      <Transition trigger="OnDelegate" source="Root|HealProvider_GlobalTask::onTankOutOfRange" target="Root"/>
      <Transition trigger="OnDelegate" source="Root|DispelProvider_GlobalTask::onNeedsHelp" target="Root"/>
      <Transition trigger="OnDelegate" source="Root|CCProvider_GlobalTask::onCCNeeded" target="Root"/>
      <Transition trigger="OnDelegate" source="Root|TargetProvider_GlobalTask::onTargetChanged" target="Root"/>
      <Transition trigger="OnDelegate" source="Root|CooldownProvider_GlobalTask::onCooldownChanged" target="Root"/>
      <Transition trigger="OnDelegate" source="Root|ManaProvider_GlobalTask::onManaChanged" target="Root">
        <Conditions>
          <Condition class="Condition_Compare" binding="Root|ManaProvider_GlobalTask::manaPct" compare="lesser" value="15"/>
        </Conditions>
      </Transition>
    </Transitions>
  </State>
</StateTree>
