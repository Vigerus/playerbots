<?xml version="1.0" encoding="utf-8"?>
<!-- Reaction state tree for Mage bots: AiPlayerbot.StateTree.Reaction.Mage -->
<Root>
  <Global>
    <!-- what a player answers in its UI: loot rolls (rolls, onRollRequested), trades (tradeOpenRequested,
         tradeAcceptRequested, onTradeRequested, onTradeAccepted), the death popups (resurrectOffered,
         canReclaimCorpse, onResurrectOffered, onReclaimCorpse) and the group invite (groupInviteRequested,
         onGroupInvited) -->
    <Task class="UIInteractionProvider_GlobalTask"/>
  </Global>
  <Node name="Roll For Item">
    <Conditions>
      <Condition binding="Root|UIInteractionProvider_GlobalTask::rolls"/>
    </Conditions>
    <!-- votes on every pending roll, greed for now -->
    <Task class="Task_RollForItem">
      <Binding local="rolls" external="Root|UIInteractionProvider_GlobalTask::rolls"/>
    </Task>
    <Transitions>
      <Transition type="OnFinish" node="Root"/>
    </Transitions>
  </Node>
  <Node name="Open Trade">
    <Conditions>
      <Condition binding="Root|UIInteractionProvider_GlobalTask::tradeOpenRequested"/>
    </Conditions>
    <!-- opens the trade window for the master / a group member / a bot, cancels any other trade -->
    <Task class="Task_OpenTrade"/>
    <Transitions>
      <Transition type="OnFinish" node="Root"/>
    </Transitions>
  </Node>
  <Node name="Accept Trade">
    <Conditions>
      <Condition binding="Root|UIInteractionProvider_GlobalTask::tradeAcceptRequested"/>
    </Conditions>
    <!-- the other player accepted: accept too -->
    <Task class="Task_AcceptTrade"/>
    <Transitions>
      <Transition type="OnFinish" node="Root"/>
    </Transitions>
  </Node>
  <Node name="Accept Resurrection">
    <Conditions>
      <Condition binding="Root|UIInteractionProvider_GlobalTask::resurrectOffered"/>
    </Conditions>
    <!-- the dead bot is offered a resurrection (also one cast at its corpse while it is a ghost): accepts it -->
    <Task class="Task_AcceptResurrection"/>
    <Transitions>
      <Transition type="OnFinish" node="Root"/>
    </Transitions>
  </Node>
  <Node name="Reclaim Corpse">
    <Conditions>
      <Condition binding="Root|UIInteractionProvider_GlobalTask::canReclaimCorpse"/>
    </Conditions>
    <!-- the ghost is at its body (the corpse run of the Dead tree) and the reclaim delay is over: "Resurrect" -->
    <Task class="Task_ReclaimCorpse"/>
    <Transitions>
      <Transition type="OnFinish" node="Root"/>
    </Transitions>
  </Node>
  <Node name="Accept Invite">
    <Conditions>
      <Condition binding="Root|UIInteractionProvider_GlobalTask::groupInviteRequested"/>
    </Conditions>
    <!-- a player invited the bot to a group: joins when the leader may invite it, declines otherwise -->
    <Task class="Task_AcceptInvite"/>
    <Transitions>
      <Transition type="OnFinish" node="Root"/>
    </Transitions>
  </Node>
  <Node name="Idle">
    <Conditions/>
    <!-- placeholder until the new AI exists: waits forever, leaves only through a transition -->
    <Task class="Task_Wait" show_log="false">
      <Delay value="0"/>
    </Task>
    <Transitions>
      <Transition type="OnDelegate" source="Root|UIInteractionProvider_GlobalTask::onRollRequested" node="Root|Roll For Item"/>
      <Transition type="OnDelegate" source="Root|UIInteractionProvider_GlobalTask::onTradeRequested" node="Root|Open Trade"/>
      <Transition type="OnDelegate" source="Root|UIInteractionProvider_GlobalTask::onTradeAccepted" node="Root|Accept Trade"/>
      <Transition type="OnDelegate" source="Root|UIInteractionProvider_GlobalTask::onResurrectOffered" node="Root|Accept Resurrection"/>
      <Transition type="OnDelegate" source="Root|UIInteractionProvider_GlobalTask::onReclaimCorpse" node="Root|Reclaim Corpse"/>
      <Transition type="OnDelegate" source="Root|UIInteractionProvider_GlobalTask::onGroupInvited" node="Root|Accept Invite"/>
    </Transitions>
  </Node>
</Root>
