<?xml version="1.0" encoding="utf-8"?>
<StateTree version="2">
  <Comment>Reaction state tree for Mage bots: AiPlayerbot.StateTree.Reaction.Mage</Comment>
  <GlobalTasks>
    <Task class="UIInteractionProvider_GlobalTask">
      <Comment>what a player answers in its UI: loot rolls (rolls, onRollRequested), trades (tradeOpenRequested,
        tradeAcceptRequested, onTradeRequested, onTradeAccepted), the death popups (resurrectOffered,
        canReclaimCorpse, onResurrectOffered, onReclaimCorpse) and the group invite (groupInviteRequested,
        onGroupInvited)</Comment>
    </Task>
  </GlobalTasks>
  <State name="Roll For Item">
    <EnterConditions>
      <Condition class="Condition_Compare" binding="Root|UIInteractionProvider_GlobalTask::rolls"/>
    </EnterConditions>
    <Tasks>
      <Task class="Task_RollForItem">
        <Comment>votes on every pending roll, greed for now</Comment>
        <Binding local="rolls" external="Root|UIInteractionProvider_GlobalTask::rolls"/>
      </Task>
    </Tasks>
    <Transitions>
      <Transition trigger="OnStateCompleted" target="Root"/>
    </Transitions>
  </State>
  <State name="Open Trade">
    <EnterConditions>
      <Condition class="Condition_Compare" binding="Root|UIInteractionProvider_GlobalTask::tradeOpenRequested"/>
    </EnterConditions>
    <Tasks>
      <Task class="Task_OpenTrade">
        <Comment>opens the trade window for the master / a group member / a bot, cancels any other trade</Comment>
      </Task>
    </Tasks>
    <Transitions>
      <Transition trigger="OnStateCompleted" target="Root"/>
    </Transitions>
  </State>
  <State name="Accept Trade">
    <EnterConditions>
      <Condition class="Condition_Compare" binding="Root|UIInteractionProvider_GlobalTask::tradeAcceptRequested"/>
    </EnterConditions>
    <Tasks>
      <Task class="Task_AcceptTrade">
        <Comment>the other player accepted: accept too</Comment>
      </Task>
    </Tasks>
    <Transitions>
      <Transition trigger="OnStateCompleted" target="Root"/>
    </Transitions>
  </State>
  <State name="Accept Resurrection">
    <EnterConditions>
      <Condition class="Condition_Compare" binding="Root|UIInteractionProvider_GlobalTask::resurrectOffered"/>
    </EnterConditions>
    <Tasks>
      <Task class="Task_AcceptResurrection">
        <Comment>the dead bot is offered a resurrection (also one cast at its corpse while it is a ghost): accepts it</Comment>
      </Task>
    </Tasks>
    <Transitions>
      <Transition trigger="OnStateCompleted" target="Root"/>
    </Transitions>
  </State>
  <State name="Reclaim Corpse">
    <EnterConditions>
      <Condition class="Condition_Compare" binding="Root|UIInteractionProvider_GlobalTask::canReclaimCorpse"/>
    </EnterConditions>
    <Tasks>
      <Task class="Task_ReclaimCorpse">
        <Comment>the ghost is at its body (the corpse run of the Dead tree) and the reclaim delay is over: "Resurrect"</Comment>
      </Task>
    </Tasks>
    <Transitions>
      <Transition trigger="OnStateCompleted" target="Root"/>
    </Transitions>
  </State>
  <State name="Accept Invite">
    <EnterConditions>
      <Condition class="Condition_Compare" binding="Root|UIInteractionProvider_GlobalTask::groupInviteRequested"/>
    </EnterConditions>
    <Tasks>
      <Task class="Task_AcceptInvite">
        <Comment>a player invited the bot to a group: joins when the leader may invite it, declines otherwise</Comment>
      </Task>
    </Tasks>
    <Transitions>
      <Transition trigger="OnStateCompleted" target="Root"/>
    </Transitions>
  </State>
  <State name="Idle">
    <Tasks>
      <Task class="Task_Wait" show_log="false">
        <Comment>placeholder until the new AI exists: waits forever, leaves only through a transition</Comment>
        <Delay value="0"/>
      </Task>
    </Tasks>
    <Transitions>
      <Transition trigger="OnDelegate" source="Root|UIInteractionProvider_GlobalTask::onRollRequested" target="Root|Roll For Item"/>
      <Transition trigger="OnDelegate" source="Root|UIInteractionProvider_GlobalTask::onTradeRequested" target="Root|Open Trade"/>
      <Transition trigger="OnDelegate" source="Root|UIInteractionProvider_GlobalTask::onTradeAccepted" target="Root|Accept Trade"/>
      <Transition trigger="OnDelegate" source="Root|UIInteractionProvider_GlobalTask::onResurrectOffered" target="Root|Accept Resurrection"/>
      <Transition trigger="OnDelegate" source="Root|UIInteractionProvider_GlobalTask::onReclaimCorpse" target="Root|Reclaim Corpse"/>
      <Transition trigger="OnDelegate" source="Root|UIInteractionProvider_GlobalTask::onGroupInvited" target="Root|Accept Invite"/>
    </Transitions>
  </State>
</StateTree>
