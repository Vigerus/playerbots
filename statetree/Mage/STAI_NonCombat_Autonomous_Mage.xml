<?xml version="1.0" encoding="utf-8"?>
<StateTree version="8">
  <Comment>NonCombat subtree for Mage bots on their own, without a leader (run by STAI_NonCombat_Mage.xml): keeps itself
    up (decurse, buffs, conjured water and food, eat, rest), loots its kills, equips better items, sells junk when the bags are full, learns
    new spells at its trainer, else grinds</Comment>
  <GlobalTasks>
    <Task class="BuffProvider_GlobalTask">
      <Comment>watches the buffs of the bot: needs, onMissingBuff</Comment>
      <Buff spellid="1459"/>
      <!-- Arcane Intellect (single) -->
      <Buff spellid="6117" group="armor"/>
      <!-- Mage Armor (self), else Ice Armor, else Frost Armor: one buff, the best the bot knows -->
      <Buff spellid="7302" group="armor"/>
      <!-- Ice Armor -->
      <Buff spellid="168" group="armor"/>
      <!-- Frost Armor -->
    </Task>
    <Task class="CurseProvider_GlobalTask">
      <Comment>watches the bot for dispellable curses: whoNeeds, onNeedsHelp</Comment>
    </Task>
    <Task class="CooldownProvider_GlobalTask">
      <Comment>the spells the tree needs the bot to know (ready: known and off cooldown)</Comment>
      <Spell id="475"/>
      <!-- Remove Lesser Curse (level 18) -->
      <Spell id="5504"/>
      <!-- Conjure Water (level 4) -->
      <Spell id="587"/>
      <!-- Conjure Food (level 6) -->
    </Task>
    <Task class="StatsProvider_GlobalTask">
      <Comment>health / mana of the bot: healthPct, onHealthChanged / manaPct, onManaChanged</Comment>
    </Task>
    <Task class="InventoryProvider_GlobalTask">
      <Comment>the bags: lowFood, lowDrink (below 5), onLowSupplies; bagsFull (below 2 free slots with something to
        sell), onBagsFull; equipItem, onItemEquipRequest (an item better than what is worn, ItemEvalSubsystem)</Comment>
      <Low value="5"/>
      <Free value="2"/>
    </Task>
    <Task class="TrainerProvider_GlobalTask">
      <Comment>spells the bot can learn and afford at its class trainer: newSpells, onNewSpells (the Train subtree goes there)</Comment>
      <Range value="2000"/>
    </Task>
    <Task class="LootProvider_GlobalTask">
      <Comment>the closest corpse the bot may loot: lootTarget, onLootable</Comment>
      <Range value="30"/>
    </Task>
    <Task class="MovementGoal_GlobalTask" name="Loot" priority="34" kind="range">
      <Comment>movement goal: to the corpse to loot</Comment>
      <Range max="3"/>
      <Dead value="true"/>
      <Binding local="target" external="Root|LootProvider_GlobalTask::lootTarget"/>
    </Task>
  </GlobalTasks>
  <State name="Check Decurse">
    <EnterConditions>
      <Condition class="Condition_Compare" binding="Root|CurseProvider_GlobalTask::whoNeeds"/>
      <Condition class="Condition_Compare" binding="Root|CooldownProvider_GlobalTask::ready" key="475"/>
    </EnterConditions>
    <Tasks>
      <Task class="Task_CastSpell" spellid="Remove Lesser Curse">
        <Binding local="whoNeeds" external="Root|CurseProvider_GlobalTask::whoNeeds"/>
        <Binding local="causes" external="Root|CurseProvider_GlobalTask::causes"/>
      </Task>
    </Tasks>
  </State>
  <State name="Loot">
    <Comment>right after a fight: the Loot goal walks to the corpse, then it is looted</Comment>
    <EnterConditions>
      <Condition class="Condition_Compare" binding="Root|LootProvider_GlobalTask::lootTarget"/>
      <Condition class="Condition_Compare" binding="Root|MovementGoal_GlobalTask[Loot]::inRange"/>
    </EnterConditions>
    <Tasks>
      <Task class="Task_Loot">
        <Binding local="target" external="Root|LootProvider_GlobalTask::lootTarget"/>
      </Task>
    </Tasks>
  </State>
  <State name="Go Loot">
    <Comment>on the way to the corpse; selects again every second (the corpse may be looted or ignored meanwhile, and an
      arrival before this state started fires no delegate)</Comment>
    <EnterConditions>
      <Condition class="Condition_Compare" binding="Root|LootProvider_GlobalTask::lootTarget"/>
    </EnterConditions>
    <Tasks>
      <Task class="Task_Wait">
        <Delay value="1000"/>
      </Task>
    </Tasks>
    <Transitions>
      <Transition trigger="OnDelegate" source="Root|MovementGoal_GlobalTask[Loot]::onArrived" target="Root|Loot"/>
      <Transition trigger="OnDelegate" source="Root|LootProvider_GlobalTask::onLootable" target="Root"/>
    </Transitions>
  </State>
  <State name="Equip">
    <Comment>a better item in the bags: worn at once (the old one goes to the bags, selling judges it again)</Comment>
    <EnterConditions>
      <Condition class="Condition_Compare" binding="Root|InventoryProvider_GlobalTask::equipItem"/>
    </EnterConditions>
    <Tasks>
      <Task class="Task_EquipItem">
        <Binding local="item" external="Root|InventoryProvider_GlobalTask::equipItem"/>
      </Task>
    </Tasks>
  </State>
  <State name="Sell">
    <Comment>full bags: to the nearest vendor and sell the junk (conjured water, loot and quest items need the room)</Comment>
    <EnterConditions>
      <Condition class="Condition_Compare" binding="Root|InventoryProvider_GlobalTask::bagsFull"/>
    </EnterConditions>
    <Tasks>
      <Task class="Task_RunSubtree">
        <Subtree filename="statetree/STAI_NonCombat_Sell.xml"/>
      </Task>
    </Tasks>
    <Transitions>
      <Transition trigger="OnDelegate" source="Root|StatsProvider_GlobalTask::onHealthChanged" target="Root">
        <Conditions>
          <Condition class="Condition_Compare" binding="Root|StatsProvider_GlobalTask::healthPct" compare="lesser" value="60"/>
        </Conditions>
      </Transition>
    </Transitions>
  </State>
  <State name="Check Missing Buffs">
    <Comment>not at low mana: the buffs wait for Eat and Drink instead of failing every time</Comment>
    <EnterConditions>
      <Condition class="Condition_Compare" binding="Root|BuffProvider_GlobalTask::needs"/>
      <Condition class="Condition_Compare" binding="Root|StatsProvider_GlobalTask::manaPct" compare="greater" value="30"/>
    </EnterConditions>
    <Tasks>
      <Task class="Task_CastBuff">
        <Binding local="needs" external="Root|BuffProvider_GlobalTask::needs"/>
      </Task>
    </Tasks>
  </State>
  <State name="Conjure Water">
    <Comment>a mage's own drink, once it knows the spell; the highest rank it knows</Comment>
    <EnterConditions>
      <Condition class="Condition_Compare" binding="Root|InventoryProvider_GlobalTask::lowDrink"/>
      <Condition class="Condition_Compare" binding="Root|CooldownProvider_GlobalTask::ready" key="5504"/>
      <Condition class="Condition_Compare" binding="Root|StatsProvider_GlobalTask::manaPct" compare="greater" value="30"/>
    </EnterConditions>
    <Tasks>
      <Task class="Task_CastSpell" spellid="Conjure Water">
        <Target value="self"/>
      </Task>
    </Tasks>
  </State>
  <State name="Conjure Food">
    <EnterConditions>
      <Condition class="Condition_Compare" binding="Root|InventoryProvider_GlobalTask::lowFood"/>
      <Condition class="Condition_Compare" binding="Root|CooldownProvider_GlobalTask::ready" key="587"/>
      <Condition class="Condition_Compare" binding="Root|StatsProvider_GlobalTask::manaPct" compare="greater" value="30"/>
    </EnterConditions>
    <Tasks>
      <Task class="Task_CastSpell" spellid="Conjure Food">
        <Target value="self"/>
      </Task>
    </Tasks>
  </State>
  <State name="Eat and Drink">
    <Comment>below 60% health or 40% mana, while the bot does not move; food and drink until both are full</Comment>
    <EnterConditions>
      <Any>
        <Condition class="Condition_Compare" binding="Root|StatsProvider_GlobalTask::healthPct" compare="lesser" value="60"/>
        <Condition class="Condition_Compare" binding="Root|StatsProvider_GlobalTask::manaPct" compare="lesser" value="40"/>
      </Any>
      <Condition class="Condition_Compare" binding="Root|MovementGoal_GlobalTask[Loot]::movement" compare="equal" value="moving" inverted="true"/>
    </EnterConditions>
    <Tasks>
      <Task class="Task_EatAndDrink">
        <Health until="100"/>
        <Mana until="100"/>
      </Task>
    </Tasks>
  </State>
  <State name="Rest">
    <Comment>nothing to eat or drink (Eat and Drink failed): sits out the regeneration, then selects again</Comment>
    <EnterConditions>
      <Any>
        <Condition class="Condition_Compare" binding="Root|StatsProvider_GlobalTask::healthPct" compare="lesser" value="60"/>
        <Condition class="Condition_Compare" binding="Root|StatsProvider_GlobalTask::manaPct" compare="lesser" value="40"/>
      </Any>
    </EnterConditions>
    <Tasks>
      <Task class="Task_Wait">
        <Delay value="10000"/>
      </Task>
    </Tasks>
  </State>
  <State name="Train">
    <Comment>new spells the bot can afford: to its class trainer before hunting on</Comment>
    <EnterConditions>
      <Condition class="Condition_Compare" binding="Root|TrainerProvider_GlobalTask::newSpells"/>
    </EnterConditions>
    <Tasks>
      <Task class="Task_RunSubtree">
        <Subtree filename="statetree/STAI_NonCombat_Train.xml"/>
      </Task>
    </Tasks>
    <Transitions>
      <Transition trigger="OnDelegate" source="Root|LootProvider_GlobalTask::onLootable" target="Root"/>
      <Transition trigger="OnDelegate" source="Root|StatsProvider_GlobalTask::onHealthChanged" target="Root">
        <Conditions>
          <Condition class="Condition_Compare" binding="Root|StatsProvider_GlobalTask::healthPct" compare="lesser" value="60"/>
        </Conditions>
      </Transition>
    </Transitions>
  </State>
  <State name="Grind">
    <Comment>the activity: hunting until upkeep is needed again</Comment>
    <Tasks>
      <Task class="Task_RunSubtree">
        <Subtree filename="statetree/Mage/STAI_NonCombat_Grind_Mage.xml"/>
      </Task>
    </Tasks>
    <Transitions>
      <Transition trigger="OnDelegate" source="Root|LootProvider_GlobalTask::onLootable" target="Root"/>
      <Transition trigger="OnDelegate" source="Root|BuffProvider_GlobalTask::onMissingBuff" target="Root|Check Missing Buffs">
        <Conditions>
          <Condition class="Condition_Compare" binding="Root|StatsProvider_GlobalTask::manaPct" compare="greater" value="30"/>
        </Conditions>
      </Transition>
      <Transition trigger="OnDelegate" source="Root|CurseProvider_GlobalTask::onNeedsHelp" target="Root|Check Decurse"/>
      <Transition trigger="OnDelegate" source="Root|TrainerProvider_GlobalTask::onNewSpells" target="Root"/>
      <Transition trigger="OnDelegate" source="Root|InventoryProvider_GlobalTask::onLowSupplies" target="Root"/>
      <Transition trigger="OnDelegate" source="Root|InventoryProvider_GlobalTask::onBagsFull" target="Root"/>
      <Transition trigger="OnDelegate" source="Root|InventoryProvider_GlobalTask::onItemEquipRequest" target="Root"/>
      <Transition trigger="OnDelegate" source="Root|StatsProvider_GlobalTask::onHealthChanged" target="Root">
        <Conditions>
          <Condition class="Condition_Compare" binding="Root|StatsProvider_GlobalTask::healthPct" compare="lesser" value="60"/>
        </Conditions>
      </Transition>
      <Transition trigger="OnDelegate" source="Root|StatsProvider_GlobalTask::onManaChanged" target="Root">
        <Conditions>
          <Condition class="Condition_Compare" binding="Root|StatsProvider_GlobalTask::manaPct" compare="lesser" value="40"/>
        </Conditions>
      </Transition>
    </Transitions>
  </State>
</StateTree>
